#!/bin/sh
set -e
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl stop minsec-id.service minsec-id-scan.timer minsec-id-scan-full.timer >/dev/null 2>&1 || true
    systemctl disable minsec-id.service minsec-id-scan.timer minsec-id-scan-full.timer >/dev/null 2>&1 || true
fi
exit 0
